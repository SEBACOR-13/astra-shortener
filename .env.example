# Token de aplicacion de Astra DB (empieza con AstraCS:)
ASTRA_DB_TOKEN=AstraCS:xxxxxxxxxxxxxxxxxxxx

# Ruta al Secure Connect Bundle descargado del portal de Astra
ASTRA_SCB_PATH=./secure-connect-shortener.zip

# Alternativa usada en CI/Render: el mismo bundle codificado en base64
# ASTRA_SCB_B64=UEsDBBQ...

ASTRA_KEYSPACE=shortener

# URL publica del servicio, usada para construir los enlaces cortos
BASE_URL=http://localhost:8000
